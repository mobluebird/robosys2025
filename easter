import sys

def easter(year):
    #ガウスの公式(グレゴリオ暦)
    a = year % 19  
    b = year // 100
    c = year % 100
    d = b // 4
    e = b% 4
    f = (b + 8) // 25
    g = (b - f + 1) // 3
    h = (19 * a + b - d - g + 15) % 30
    i = c // 4
    k = c % 4
    l = (32 + 2 * e + 2 * i - h - k) % 7
    m = (a + 11 * h + 22 * l) // 451
    month = (h + l - 7 * m + 114) // 31  #3=March, 4=April
    day = ((h + l - 7 * m + 114) % 31) + 1

    return f"{year:04d} {month:02d} {day:02d}"

#標準入力から西暦年を読み込み、復活祭の日付を出力する
def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            year = int(line)
            print(easter(year))
        except ValueError:
            print(f"入力が正しくありません: {line}", file=sys.stderr)

if __name__ == "__main__":
    main()
